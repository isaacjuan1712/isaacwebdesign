# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Contact form delivery. Get a free key at https://web3forms.com (enter your email,
# the key arrives by mail). It's public by design: it can only send to your inbox.
NEXT_PUBLIC_WEB3FORMS_KEY=

# The site's public address, without a trailing slash. Used for the canonical URL,
# sitemap.xml, robots.txt and share previews. On Vercel you can leave it unset until
# you connect a domain: the Vercel production URL is used automatically.
NEXT_PUBLIC_SITE_URL=
